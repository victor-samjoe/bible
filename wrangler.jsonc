{
  // Infraestrutura definitiva: Cloudflare Workers (sem túnel).
  // Deploy via @opennextjs/cloudflare. Ver docs/CLOUDFLARE_INFRA.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "samjoe-estudos",
  "main": ".open-next/worker.js",
  "workers_dev": true,
  "routes": [
    { "pattern": "bibliabereianos.com.br", "custom_domain": true }
  ],
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // Gerado por `opennextjs-cloudflare build`; nao alterar o caminho.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // `service` precisa ser igual a `name` acima.
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "samjoe-estudos" }
  ],

  "images": { "binding": "IMAGES" },

  "observability": { "enabled": true },

  // Origem publica usada para montar o `redirect_to` do link de e-mail da
  // autenticacao. Nao e segredo: e o endereco publico do app, por isso fica
  // aqui e nao em `wrangler secret`. Ver `src/server/auth/config.ts`, que
  // exige origem absoluta, sem path nem query, e https fora de localhost.
  "vars": { "PUBLIC_SITE_URL": "https://bibliabereianos.com.br" },

  // Bindings de R2, fila e Hyperdrive entram somente quando a aplicação
  // realmente consumir cache incremental ou Postgres diretamente no Worker.
  // O MVP atual mantém autorização e dados sensíveis fora do cache público.
}
