# Nome exibido; o fallback é Bíblia Bereana.
PUBLIC_APP_NAME=Bíblia Bereana
PUBLIC_COMPANY_NAME=SamJoE Tech & Consulting

# Integrações externas permanecem indisponíveis sem configuração.
# Não versionar este token; necessário apenas para provisionamento via CLI/API.
SUPABASE_ACCESS_TOKEN=
SUPABASE_URL=
# Chave pública atual do Supabase (sb_publishable_...).
SUPABASE_PUBLISHABLE_KEY=
# Chave secreta atual; somente backend, nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Compatibilidade temporária com projetos que ainda usem chaves legadas.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct connection do Supabase (Project Settings > Database > Connection string
# > Direct connection). Usada por drizzle-kit para migrations e por scripts
# locais. NÃO é usada pelo Worker em produção: lá a conexão vem do binding
# HYPERDRIVE. Não usar as strings do pooler (Supavisor) aqui.
DATABASE_URL=

# Pagamentos: definir o provedor escolhido antes de qualquer cobrança.
BILLING_PROVIDER=
BILLING_API_KEY=
BILLING_WEBHOOK_SECRET=

WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER_URL=
WHATSAPP_PROVIDER_TOKEN=
BIBLE_TRANSLATION_ENABLED=false

# Hospedagem: Cloudflare Workers (@opennextjs/cloudflare). Segredos de produção
# são definidos com `wrangler secret put`, não neste arquivo.
# Ver docs/CLOUDFLARE_INFRA.md.
